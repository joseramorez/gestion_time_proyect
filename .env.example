# Credenciales de la app OAuth 2.0 (3LO) de Atlassian para el login de Jira.
#
# Cómo usarlo:
#   1. Copia este archivo como `.env` (junto a pubspec.yaml). `.env` está en .gitignore:
#      NUNCA se sube al repositorio.
#   2. Pon tu Client ID y tu Secret (consola de desarrolladores de Atlassian →
#      tu app → Settings → Authentication details).
#   3. Compila con el script, que pasa el .env solo si existe:
#        Windows:        powershell -File tool/flutter_env.ps1 run -d windows
#        macOS / Linux:  tool/flutter_env.sh run -d macos
#      o a mano:  flutter run -d windows --dart-define-from-file=.env
#
# Con las DOS claves rellenas, las credenciales se compilan dentro de la app: no hay que
# escribirlas y el diálogo de Jira ya no las pide. Si dejas alguna vacía (o no hay .env),
# la app las pide y las guarda en el almacén seguro del sistema operativo.
#
# Ojo: quien tenga el binario compilado puede extraer el secreto. Úsalo para tu propia
# máquina o para una app de Atlassian que aceptes que sea de uso interno.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Meta de horas por día (progreso y corte del día) (acepta decimales: 7.5). Sin valor, un valor
# inválido, 0 o más de 24 → 8 horas. Se lee al COMPILAR: si la cambias, vuelve a compilar.
DAILY_HOURS=8

# Mínimo aceptable del día (referencia: no se impone). Por defecto 7. Nunca pasa de DAILY_HOURS.
DAILY_MIN_HOURS=7

# Sincronización automática de Jira (ajuste en "Ventana"): cada cuántas horas trae tus tickets.
# Acepta decimales (0.5 = 30 min). Sin valor, inválido, 0 o más de 24 → 2 horas; el mínimo
# es 5 minutos. Se lee al COMPILAR: si la cambias, vuelve a compilar.
JIRA_AUTO_SYNC_HOURS=2
